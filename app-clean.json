{
  "expo": {
    "name": "Esusu",
    "slug": "esusu-app-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.esusuappv1",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "This app needs access to camera to take photos for contributor verification.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select images for contributor verification."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.example.esusuappv1",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F3FF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons.png",
          "color": "#0072CE",
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new updates",
          "iosDisplayInForeground": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take photos for contributor verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you select images for contributor verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "caae719c-2d0c-441d-a762-6363297448f5"
      }
    }
  }
}
