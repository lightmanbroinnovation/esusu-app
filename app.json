{
  "expo": {
    "name": "Esusu",
    "slug": "esusu-app-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Esusu-Icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.esusuappv1",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to take photos.",
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to provide better services."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Esusu-Icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.example.esusuappv1",
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F3FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "caae719c-2d0c-441d-a762-6363297448f5"
      },
      "FIREBASE_API_KEY": "YOUR_FIREBASE_API_KEY",
      "FIREBASE_AUTH_DOMAIN": "YOUR_PROJECT.firebaseapp.com",
      "FIREBASE_PROJECT_ID": "YOUR_PROJECT_ID",
      "FIREBASE_STORAGE_BUCKET": "YOUR_PROJECT.appspot.com",
      "FIREBASE_MESSAGING_SENDER_ID": "YOUR_SENDER_ID",
      "FIREBASE_APP_ID": "YOUR_WEB_APP_ID",
      "FIREBASE_MEASUREMENT_ID": "YOUR_MEASUREMENT_ID",
      "FIREBASE_VAPID_KEY": "YOUR_WEB_PUSH_CERTIFICATE_VAPID_KEY"
    }
  }
}
